# ===== RU-MD backend configuration =====
# Copy this file to ".env" and adjust the values for your environment.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed front-end origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Database engine: "mysql" (default, used in production on Hostinger / local XAMPP)
DB_CLIENT=mysql

# MySQL (XAMPP defaults: host 127.0.0.1, port 3306, user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ruaa_healthcare

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# Default admin account created by the seed script
ADMIN_EMAIL=admin@rumd.me
ADMIN_PASSWORD=Admin@12345

# ===== Telemedicine (video / voice consultations) =====
# Wall-clock timezone used for appointment slots.
TELEMED_TZ=Asia/Riyadh
# Jitsi server used for the embedded room (also editable from Admin → Settings → jitsi_domain).
# NOTE: the public meet.jit.si is DEMO ONLY when embedded: it shows a warning and drops the
# call after 5 minutes, and needs one participant to sign in as moderator. For production use
# 8x8 JaaS (free 25 MAU tier, set the three JAAS_* values below) or a self-hosted Jitsi.
JITSI_DOMAIN=meet.jit.si
# Optional — 8x8 JaaS (https://jaas.8x8.vc): when all three are set, rooms open on 8x8.vc with a
# signed token (doctor/admin = moderator, patient = guest) and no manual login is needed.
JAAS_APP_ID=
JAAS_KEY_ID=
# Paste the RS256 private key with line breaks escaped as \n
JAAS_PRIVATE_KEY=
